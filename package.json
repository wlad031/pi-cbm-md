{
  "name": "pi-cbm-md",
  "version": "0.1.0",
  "type": "module",
  "description": "Markdown-focused Pi extension with native tools for listing, outlining, reading, and searching Markdown/MDX docs.",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "markdown",
    "mdx",
    "docs",
    "codebase-memory"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@types/node": "^25.9.1",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlad031/pi-cbm-md.git"
  },
  "bugs": {
    "url": "https://github.com/wlad031/pi-cbm-md/issues"
  },
  "homepage": "https://github.com/wlad031/pi-cbm-md#readme"
}
